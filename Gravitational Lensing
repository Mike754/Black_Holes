#Circle of points approximating a spherical object. The lensing function essentially takes this background of points and projects 
#The lensed points in the graph. I do not include the origional points in the graph because they look ugly and cluttered.
# Code was modified from: 
https://kushalpokhrel.medium.com/visualization-of-black-holes-and-gravitational-lensing-using-python-and-plotly-418ee5e48cfb

import numpy as np
import plotly.graph_objects as go

# Constants
circle_center_x = 0
circle_center_y = 0  
circle_radius = 1
size = 10000 # Increase number of points for better density

# Generate filled circle of points
r = np.sqrt(np.random.uniform(0, 1, size)) * circle_radius  # Random radius values
theta = np.random.uniform(0, 2 * np.pi, size)  # Random angle values
circle_x = circle_center_x + r * np.cos(theta)  # Cartesian X coordinates
circle_y = circle_center_y + r * np.sin(theta)  # Cartesian Y coordinates

# Schwarzschild radius and constants
Rs = 2 * mass  # Schwarzschild radius
D_S = 25  # Distance from source
D_L = 100  # Distance from lens
D_LS = D_S + D_L  # Total distance
mass = 100  # Mass of the black hole

# Lensing function
def gravitational_lens(circle_x, circle_y, mass):
    r = np.sqrt(circle_x**2 + circle_y**2)
    beta = np.arctan2(circle_y, circle_x)
    theta_E = np.sqrt(2 * Rs * (D_LS / (D_S * D_L)))  # Einstein angle

    # Lensing transformation (focusing on one solution for simplicity)
    theta1 = (beta + np.sqrt(abs(beta**2 - 4 * theta_E**2)))  # Angle solution
    theta2 = (beta - np.sqrt(abs(beta**2 - 4 * theta_E**2)))
    deflection = mass / r  # Deflection due to mass
    x1_new = circle_x - deflection * np.cos(theta1)  # New coordinates after deflection
    y1_new = circle_y - deflection * np.sin(theta1)
    x2_new = circle_x - deflection * np.cos(theta2)
    y2_new = circle_y - deflection * np.sin(theta2)
    
    return x1_new, y1_new, x2_new, y2_new

# Apply gravitational lensing to the filled circle points
X1_lens, Y1_lens, X2_lens, Y2_lens = gravitational_lens(circle_x, circle_y, mass)

# Plot the figure
fig = go.Figure()

fig.add_shape(type="circle",
    xref="x", yref="y",
    fillcolor="black",
    x0=-100, y0=-100, x1=100, y1=100,
    line_color="firebrick")

# Add the lensed points as a scatter plot
#fig.add_trace(go.Scatter(x=circle_x.flatten(), y=circle_y.flatten(), mode='markers', marker=dict(color='blue', size=3)))
fig.add_trace(go.Scatter(x=X1_lens.flatten(), y=Y1_lens.flatten(), mode='markers', marker=dict(color='darkorange', size=3)))
fig.add_trace(go.Scatter(x=X2_lens.flatten(), y=Y2_lens.flatten(), mode='markers', marker=dict(color='firebrick', size=3)))

# make graph look pretty
fig.update_layout(
    title='Gravitational Lensing Simulation',
    xaxis_title='X',
    yaxis_title='Y',
    margin=dict(l=5, r=5, t=5, b=5),
    paper_bgcolor="floralwhite",
    plot_bgcolor="black", 
    width=800,
    height=800,
    xaxis=dict(scaleanchor="y"),
)

# Show the plot
fig.show()
